In render(), find the $stats array and add these keys:
php

            'lastBackup'    => $this->lastBackupInfo()['time'],
            'backupAge'     => $this->lastBackupInfo()['age'],
            'backupHealthy' => $this->lastBackupInfo()['healthy'],

Add this private method before render():
php

    protected function lastBackupInfo(): array
    {
        try {
            $backups = \Illuminate\Support\Facades\Storage::disk('local')->files('Laravel');

            if (empty($backups)) {
                $backups = \Illuminate\Support\Facades\Storage::disk('local')->files();
            }

            $zips = collect($backups)->filter(fn ($f) => str_ends_with($f, '.zip'));

            if ($zips->isEmpty()) {
                return ['time' => null, 'age' => 'Never', 'healthy' => false];
            }

            $latest = $zips
                ->map(fn ($f) => [
                    'path' => $f,
                    'time' => \Illuminate\Support\Facades\Storage::disk('local')->lastModified($f),
                ])
                ->sortByDesc('time')
                ->first();

            $ageHours = round((time() - $latest['time']) / 3600, 1);

            return [
                'time'    => \Carbon\Carbon::createFromTimestamp($latest['time'])->diffForHumans(),
                'age'     => $ageHours.'h ago',
                'healthy' => $ageHours < 36,
            ];
        } catch (\Throwable $e) {
            return ['time' => null, 'age' => 'Error', 'healthy' => false];
        }
    }

